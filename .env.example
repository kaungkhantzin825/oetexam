APP_NAME="OET Radiographer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — the platform reuses an existing schema. Point this at your own
# MySQL/MariaDB database. `php artisan migrate` creates the tables when the
# database is empty; the migrations are GUARDED, so an existing database (and
# all of its data) is left completely untouched.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ortexamm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@oetradiographer.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI — Gemini primary, Mistral automatic fallback. Leave MISTRAL_API_KEY blank
# to disable the fallback. These keys must never reach the browser.
# ---------------------------------------------------------------------------
AI_ENABLED=true
# One wall-clock budget shared by every provider/model/retry in a single
# request. Keep it below the SAPI max_execution_time (60s) — the AI controllers
# raise that limit with set_time_limit() to give it headroom.
AI_TOTAL_BUDGET_SECONDS=45
# Never start a model call with less than this left on the clock.
AI_MIN_ATTEMPT_SECONDS=5
AI_MAX_RETRIES=1
AI_RETRY_BASE_MS=800

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
# Per-call ceiling only; the shared budget clamps it to the time actually left.
GEMINI_TIMEOUT_SECONDS=40

MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-nemo
MISTRAL_FALLBACK_MODELS=ministral-8b-latest,ministral-3b-latest,codestral-latest
MISTRAL_MAX_OUTPUT_TOKENS=8192
MISTRAL_TIMEOUT_SECONDS=40
MISTRAL_TTS_MODEL=voxtral-mini-tts-latest
MISTRAL_TTS_VOICE=gb_oliver_neutral

OET_UPLOADS_MAX_MB=25

VITE_APP_NAME="${APP_NAME}"
